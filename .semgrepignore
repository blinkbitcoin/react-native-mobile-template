# Ruby's naming convention (lanes_test.rb, not lanes.test.rb) isn't covered by
# the glob above. This is fastlane's own unit test suite: it asserts against a
# minimal placeholder service-account JSON stub with no key material, never a
# real credential.
fastlane/test/
# A decoy Google service-account key (fake project id "decoy-project-123456",
# key id "0000...dead"). tests/run.sh feeds it to scripts/validate-play-json.sh
# to exercise that validator; not a real credential.
.claude/skills/store-credentials/tests/fixtures/
# A copy of AndroidManifest.xml used only to test scripts/release's OTA

# Public (inlined into the JS bundle, visible to users). Only EXPO_PUBLIC_* reach app code.
# 8082 is APP_PORT_BASE + 2, the mock API's default port (scripts/ports.mjs).
# Expo bakes this into the bundle, so it is the value a bare `expo start` uses;
# the Makefile's run targets export the port actually derived at run time.
EXPO_PUBLIC_API_URL=http://localhost:8082/graphql
EXPO_PUBLIC_APP_NAME=RN Mobile Template
EXPO_PUBLIC_WEB_DOMAIN=
EXPO_PUBLIC_ALLOW_INSECURE_WEB_STORAGE=false

# Build-time only (read by app.config.ts and CI; NEVER prefixed EXPO_PUBLIC_):
# APP_VARIANT=development|production   OTA_ENABLED=false   EXPO_UPDATES_URL=
# APP_VERSION / APP_BUILD_NUMBER are set by CI.

# Release only, read by fastlane and scripts/release/* (NEVER prefixed
# EXPO_PUBLIC_). Every name below is one a lane or script actually reads; the
# secrets live in the CI secret store, never in a file here. The runbook's
# secret table is the authoritative list: docs/release-runbook.md.
#
# IOS_BUNDLE_ID IOS_SCHEME ANDROID_PACKAGE  # asserted by Fastfile before_all
# MATCH_GIT_URL                             # the match certificate repo
# MATCH_PASSWORD                            # decrypts that repo
# MATCH_GIT_BASIC_AUTHORIZATION             # base64 user:token for a private one
# ASC_KEY_ID ASC_ISSUER_ID                  # App Store Connect API key identity
# ASC_KEY_P8_BASE64                         # the .p8 itself, base64-encoded
# ANDROID_UPLOAD_KEYSTORE_PATH              # upload keystore (absolute or repo-relative)
# ANDROID_UPLOAD_KEYSTORE_PASSWORD          # its store password
# ANDROID_UPLOAD_KEY_ALIAS                  # the signing key inside it
# ANDROID_UPLOAD_KEY_PASSWORD               # that key's password
# ANDROID_UPLOAD_CERT_SHA256                # expected signing cert; verify-android.sh
# PLAY_SERVICE_ACCOUNT_JSON                 # Play credentials as JSON content
# PLAY_SERVICE_ACCOUNT_JSON_PATH            # or as a path to the decoded file
# TESTFLIGHT_INTERNAL_GROUP                 # group upload_internal adds the build to
# TESTFLIGHT_EXTERNAL_GROUP                 # group promote_beta distributes to
# PLAY_ROLLOUT PLAY_UPDATE_PRIORITY         # production rollout knobs
# IOS_PHASED_RELEASE                        # App Store phased release on/off
# RELEASE_NOTES_STORE_FILE                  # single-locale store notes
# STORE_NOTES_JSON                          # per-locale store notes (notes.mjs)
# BUILD_INFO_FILE                           # build-info.json for this build
# WORKFLOWS_OUTPUT_DIR WORKFLOWS_ASSETS_DIR             # where a lane writes / reads artifacts
# BUNDLETOOL_JAR                            # when bundletool is not on PATH
# DRY_RUN=1                                 # rehearse a lane, touching no store
# APP_REVIEW_FIRST_NAME APP_REVIEW_LAST_NAME APP_REVIEW_PHONE
# APP_REVIEW_EMAIL APP_REVIEW_DEMO_USER APP_REVIEW_DEMO_PASSWORD
# APP_REVIEW_NOTES                          # App Review contact and demo account

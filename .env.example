# Public (inlined into the JS bundle, visible to users). Only EXPO_PUBLIC_* reach app code.
EXPO_PUBLIC_API_URL=http://localhost:4000/graphql
EXPO_PUBLIC_APP_NAME=RN Mobile Template
EXPO_PUBLIC_WEB_DOMAIN=
EXPO_PUBLIC_ALLOW_INSECURE_WEB_STORAGE=false

# Build-time only (read by app.config.ts and CI; NEVER prefixed EXPO_PUBLIC_):
# APP_VARIANT=development|production   OTA_ENABLED=false   EXPO_UPDATES_URL=
# APP_VERSION / APP_BUILD_NUMBER are set by CI.

# Release only, read by fastlane (NEVER prefixed EXPO_PUBLIC_). Names listed for
# reference; the secrets live in the CI secret store, never in a file here.
# See docs/release-runbook.md.
#   Identity:    IOS_BUNDLE_ID   IOS_SCHEME   ANDROID_PACKAGE
#   Signing:     MATCH_GIT_URL   MATCH_PASSWORD
#   App Store:   ASC_KEY_ID   ASC_ISSUER_ID   ASC_KEY_P8_BASE64
#   Play:        PLAY_JSON_KEY_DATA
#   Inputs:      RELEASE_NOTES_STORE_FILE   BUILD_INFO_FILE   DRY_RUN=1
#   App Review:  APP_REVIEW_FIRST_NAME   APP_REVIEW_LAST_NAME   APP_REVIEW_PHONE
#                APP_REVIEW_EMAIL   APP_REVIEW_DEMO_USER
#                APP_REVIEW_DEMO_PASSWORD   APP_REVIEW_NOTES

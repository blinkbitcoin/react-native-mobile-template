{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "index.ts",
    "App.tsx",
    "app.config.ts",
    "lingui.config.ts",
    "src/app/**/*.tsx",
    "plugins/*.ts",
    "modules/*/index.ts",
    "mocks/server.ts",
    "scripts/*.mjs",
    "scripts/*.ts"
  ],
  "project": [
    "*.{ts,tsx}",
    "src/**/*.{ts,tsx}",
    "plugins/**/*.ts",
    "modules/**/*.ts",
    "mocks/**/*.ts",
    "scripts/**/*.{mjs,ts}"
  ],
  "ignore": [
    ".rnw/**",
    "src/graphql/generated/**",
    "src/i18n/locales/**/messages.ts",
    "modules/**/ios/**",
    "modules/**/android/**"
  ],
  "ignoreDependencies": ["ts-node", "expo-system-ui"],
  "ignoreBinaries": ["typos", "maestro", "xcrun", "adb", "make"],
  "jest": {
    "config": "jest.config.ts"
  },
  "expo": true,
  "graphql-codegen": true,
  "playwright": true,
  "ignoreUnresolved": ["babel-jest"],
  "ignoreExportsUsedInFile": true,
  "tags": ["-knipignore"]
}

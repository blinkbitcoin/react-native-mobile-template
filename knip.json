{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "lingui.config.ts",
    "src/app/**/*.tsx",
    "plugins/*.ts",
    "modules/*/index.ts",
    "scripts/**/*.mjs"
  ],
  "project": [
    "*.{ts,tsx}",
    "src/**/*.{ts,tsx}",
    "plugins/**/*.ts",
    "modules/**/*.ts",
    "mocks/**/*.ts",
    "scripts/**/*.mjs"
  ],
  "ignoreDependencies": ["ts-node", "expo-system-ui"],
  "ignoreBinaries": ["typos", "make", "mise", "shasum"],
  "jest": {
    "config": "jest.config.ts"
  },
  "expo": true,
  "graphql-codegen": true,
  "playwright": true,
  "ignoreUnresolved": ["babel-jest"],
  "ignoreExportsUsedInFile": true,
  "tags": ["-knipignore"]
}

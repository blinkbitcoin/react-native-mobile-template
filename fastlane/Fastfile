# Root Fastfile: ios/ and android/ are regenerated by `expo prebuild`, so nothing lives inside them.
fastlane_require 'json'

import 'lanes/shared.rb'
import 'lanes/ios.rb'
import 'lanes/android.rb'
import 'lanes/future.rb'

before_all do |lane, options|
  next if ENV['FASTLANE_SKIP_ENV_ASSERT'] == '1' # unit tests

  require_env!(%w[APP_VERSION APP_BUILD_NUMBER IOS_BUNDLE_ID IOS_SCHEME ANDROID_PACKAGE])
end

.superpowers/

# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

# Keys and certificates. Private keys never get committed; the expo-updates
# code-signing *certificate* is public by design and is the one exception
# (see certs/README.md).
*.pem
!/certs/*.pem
/keys/

# local env files
.env*.local

# OTA deploy: .env holds EOO_PRIVATE_KEY (the expo-updates signing key) and the
# publish tokens; data/ is the update store the server writes.
/deploy/ota/.env
/deploy/ota/data/

# typescript
*.tsbuildinfo

# per-build provenance record (scripts/release/build-info.sh)
/build-info.json

# generated native folders (Continuous Native Generation: never commit these)
/ios
/android
# Gradle output for local modules, produced by `make android`
modules/*/android/build/
modules/*/android/.cxx/

# Playwright / Maestro / coverage / build output
/coverage
/dist
/playwright-report
/test-results
/.maestro/output

# Ruby gems for fastlane/cocoapods (Gemfile.lock is committed, the gems are not)
/vendor/bundle

# fastlane run output and local release credentials (never committed).
# Signing material is covered by the *.jks/*.keystore/*.p8/*.p12/*.key rules
# above; fastlane/*.json is where a Play service-account key lands, and
# fastlane/.env* is where people put MATCH_PASSWORD and ASC_*.
/fastlane/report.xml
/fastlane/README.md
/fastlane/test_output/
/fastlane/.env*
/fastlane/*.json
# Screenshots are generated, but the directories are kept so fastlane and CI
# have somewhere to write.
/fastlane/screenshots/*
!/fastlane/screenshots/.gitkeep
/fastlane/metadata/ios/screenshots/*
!/fastlane/metadata/ios/screenshots/.gitkeep
/fastlane/metadata/android/*/images/*
!/fastlane/metadata/android/*/images/.gitkeep

# react-native-workflows self-checkout (also added to .git/info/exclude by its setup action)
/.rnw

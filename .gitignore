.superpowers/

# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

# Keys and certificates. Private keys never get committed; the expo-updates
# code-signing *certificate* is public by design and is the one exception
# (see certs/README.md).
*.pem
!/certs/*.pem
/keys/

# local env files
.env*.local

# OTA deploy: .env holds EOO_PRIVATE_KEY (the expo-updates signing key) and the
# publish tokens; data/ is the update store the server writes.
/deploy/ota/.env
/deploy/ota/data/

# typescript
*.tsbuildinfo

# per-build provenance record (scripts/release/build-info.sh)
/build-info.json

# generated native folders (Continuous Native Generation: never commit these)
/ios
/android
# Gradle output for local modules, produced by `make android`
modules/*/android/build/
modules/*/android/.cxx/

# `make codeql` output: the database, results.sarif and the two tool logs.
# Hundreds of MB, and rebuilt from the tree on every run.
/.codeql

# Playwright / Maestro / coverage / build output
/coverage
/dist
/playwright-report
/test-results
/.maestro/output

# Ruby gems for fastlane/cocoapods (Gemfile.lock is committed, the gems are not)
# No trailing path: a git worktree commonly symlinks `vendor` at the bundle the
# main clone already installed, and `/vendor/bundle` does not match a symlink
# named `vendor` - the same gap that once let a `node_modules` symlink be
# committed. Nothing under vendor/ is tracked.
/vendor

# fastlane run output and local release credentials (never committed).
# Signing material is covered by the *.jks/*.keystore/*.p8/*.p12/*.key rules
# above; fastlane/*.json is where a Play service-account key lands, and
# fastlane/.env* is where people put MATCH_PASSWORD and ASC_*.
/fastlane/report.xml
/fastlane/README.md
/fastlane/test_output/
/fastlane/.env*
/fastlane/*.json
# Store assets are NOT ignored: the sync lanes push whatever these directories
# hold to App Store Connect and Google Play, and a CI checkout only has what
# the tree carries - so the screenshots, icon, feature graphic and promo
# graphic belong in the repository. Nothing in scripts/, fastlane/, the
# Makefile or the workflows generates files here; the only writer is
# `pull_metadata`, which downloads the console's copy for review.
# iOS screenshots live under fastlane/screenshots/<locale>/ (deliver's own
# default) rather than fastlane/metadata/ios/screenshots/, which deliver
# refuses to see (assert_ios_metadata_dirs! in fastlane/lanes/shared.rb).
# The .gitkeep files keep the empty template directories in the tree.

# Release artifacts. `artifacts/` is where the lanes write by default, but
# WORKFLOWS_OUTPUT_DIR can point anywhere, so the shapes are ignored by extension too.
/artifacts
*.aab
*.apk
*.ipa
*.xcarchive
*.dSYM.zip
mapping.txt

# shared-workflows self-checkout (also added to .git/info/exclude by its setup action)
/.workflows

# Per-machine lefthook overrides (see CONTRIBUTING.md)
/lefthook-local.yml

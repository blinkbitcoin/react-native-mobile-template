.superpowers/

# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders (Continuous Native Generation: never commit these)
/ios
/android
# Gradle output for local modules, produced by `make android`
modules/*/android/build/
modules/*/android/.cxx/

# Playwright / Maestro / coverage / build output
/coverage
/dist
/playwright-report
/test-results
/.maestro/output

# Ruby gems for fastlane/cocoapods (Gemfile.lock is committed, the gems are not)
/vendor/bundle

# fastlane run output
/fastlane/report.xml
/fastlane/README.md

# react-native-workflows self-checkout (also added to .git/info/exclude by its setup action)
/.rnw

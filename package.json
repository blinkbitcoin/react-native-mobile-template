{
  "name": "react-native-mobile-template",
  "version": "0.7.0",
  "main": "expo-router/entry",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "expo": {
    "install": {
      "exclude": [
        "jest",
        "@types/jest"
      ]
    }
  },
  "dependencies": {
    "@apollo/client": "^4.2.12",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@lingui/core": "^6.6.0",
    "@lingui/react": "^6.6.0",
    "expo": "~57.0.23",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.22",
    "graphql": "^16.14.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-error-boundary": "^6.1.4",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "rxjs": "^7.8.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@expo/fingerprint": "^0.20.13",
    "@graphql-codegen/cli": "^7.4.0",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@graphql-tools/schema": "^10.1.0",
    "@lingui/babel-plugin-lingui-macro": "^6.6.0",
    "@lingui/cli": "^6.6.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "expo-doctor": "^1.20.4",
    "globals": "^17.12.0",
    "graphql-yoga": "^5.22.0",
    "jest": "^30.5.1",
    "jest-expo": "~57.0.5",
    "knip": "^6.34.0",
    "lefthook": "^2.1.12",
    "msw": "^2.15.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "lefthook install",
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "build:web": "bash scripts/build-web.sh",
    "prebuild": "expo prebuild --clean",
    "doctor": "node scripts/doctor.mjs",
    "test:scripts": "node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"scripts/**/*.test.mjs\"",
    "test": "jest",
    "test:coverage": "jest --coverage && pnpm check:coverage-empty",
    "check:coverage-empty": "node scripts/check-coverage-empty.mjs",
    "badges:render": "node scripts/badges/render.mjs",
    "test:e2e:ios": "bash scripts/e2e/maestro-ios.sh",
    "test:e2e:android": "bash scripts/e2e/maestro-android.sh",
    "test:e2e:web": "bash scripts/e2e/web.sh",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint . && eslint . --max-warnings=0",
    "lint:fix": "biome check --write . && eslint . --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "spell": "typos",
    "i18n:extract": "lingui extract --clean && lingui compile",
    "i18n:check": "bash scripts/check-i18n.sh",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "bash scripts/check-codegen.sh",
    "check-prebuild": "bash scripts/check-prebuild.sh",
    "check:docs": "make check-docs",
    "check:release": "make check-release",
    "check:ci": "make check-ci",
    "check:secrets": "make check-secrets",
    "check:bundle-secrets": "make check-security-bundle",
    "mock-api": "tsx mocks/server.ts",
    "deps:check": "bash scripts/check-deps.sh",
    "deps:doctor": "expo-doctor",
    "deps:audit": "pnpm audit --audit-level=high --prod && bash scripts/check-lockfile.sh",
    "deps:licenses": "node scripts/check-licenses.mjs",
    "check-bundle-secrets": "bash scripts/check-bundle-secrets.sh"
  }
}

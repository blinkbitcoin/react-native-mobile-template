{
  "name": "react-native-mobile-template",
  "version": "0.10.1",
  "main": "expo-router/entry",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "expo": {
    "install": {
      "exclude": [
        "jest",
        "@types/jest"
      ]
    }
  },
  "dependencies": {
    "@apollo/client": "^4.3.1",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@lingui/core": "^6.8.0",
    "@lingui/react": "^6.8.0",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.23",
    "graphql": "^16.14.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-error-boundary": "^6.1.6",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.10.0",
    "react-native-screens": "~4.28.0",
    "react-native-web": "^0.21.3",
    "react-native-worklets": "0.13.0",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@blinkbitcoin/app-tooling": "github:blinkbitcoin/shared-workflows#b8a28fe92945c24de872699f64562a1bb7c09f75&path:/packages/app-tooling",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@expo/fingerprint": "^0.20.13",
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/client-preset": "^6.2.0",
    "@graphql-tools/schema": "^10.1.1",
    "@lingui/babel-plugin-lingui-macro": "^6.6.0",
    "@lingui/cli": "^6.8.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "expo-doctor": "^1.20.4",
    "globals": "^17.12.0",
    "graphql-yoga": "^5.24.1",
    "jest": "^30.5.2",
    "jest-expo": "~57.0.5",
    "knip": "^6.38.0",
    "lefthook": "^2.1.14",
    "msw": "^3.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "lefthook install",
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "build:web": "build-web",
    "prebuild": "expo prebuild --clean",
    "test:scripts": "test-scripts",
    "test": "jest",
    "test:coverage": "jest --coverage && pnpm check:coverage-empty",
    "test:app": "test-app",
    "check:coverage-empty": "check-coverage-empty",
    "test:e2e:ios": "bash scripts/e2e/maestro.sh ios",
    "test:e2e:android": "bash scripts/e2e/maestro.sh android",
    "test:e2e:web": "bash scripts/e2e/web.sh",
    "test:watch": "jest --watch",
    "check:types": "tsc --noEmit",
    "check:lint": "biome lint . && eslint . --max-warnings=0",
    "fix:lint": "biome check --write . && eslint . --fix",
    "fix:format": "biome format --write .",
    "check:format": "biome format .",
    "check:spell": "typos",
    "gen:i18n": "lingui extract --clean && lingui compile",
    "gen:graphql": "graphql-codegen --config codegen.ts",
    "check:prebuild": "check-prebuild",
    "check:docs": "make check-docs",
    "check:release": "make check-release",
    "check:ci": "make check-ci",
    "check:secrets": "make check-secrets",
    "dev:api": "tsx mocks/server.ts",
    "check:audit": "pnpm audit --audit-level=high --prod && check-lockfile",
    "check:unused": "eval \"$(pnpm exec ports --sh)\" && knip",
    "check:generated": "bash node_modules/@blinkbitcoin/app-tooling/checks/generated.sh",
    "check:expo-health": "bash node_modules/@blinkbitcoin/app-tooling/checks/expo-health.sh",
    "check:licenses": "check-licenses"
  }
}
